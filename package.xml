<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>knowledge_tools</name>
  <version>0.0.0</version>

  <description>
    High-level facade tools for interacting with the knowledge manager.
  </description>

  <maintainer email="jorge.martinezram@ingenieria.unam.edu">
    fidel
  </maintainer>

  <license>Apache-2.0</license>

  <!-- ======================================================= -->
  <!-- Build Tool -->
  <!-- ======================================================= -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ======================================================= -->
  <!-- Dependencies -->
  <!-- ======================================================= -->

  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>knowledge_interfaces</depend>
  <depend>nlohmann_json</depend>

  <!-- ======================================================= -->
  <!-- Testing -->
  <!-- ======================================================= -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- ======================================================= -->
  <!-- Export -->
  <!-- ======================================================= -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
